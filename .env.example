# API Nest local. Remova esta variável para usar o acervo de exemplo.
BC_API_URL=http://127.0.0.1:8788/v1
# Base pública usada pelo navegador para autenticação e cookie de sessão.
NEXT_PUBLIC_BC_API_URL=http://127.0.0.1:8788
# Contêiner do Google Tag Manager (GTM-XXXXXXX). Vazio desliga o GTM.
# Entra no build: mudar exige nova imagem.
NEXT_PUBLIC_GTM_ID=

# Chave pública do projeto no PostHog (phc_...), região US. Vazio ou fora do
# formato desliga a analítica e o banner de cookies (se o GTM também estiver
# vazio). Nunca a chave pessoal (phx_), que é segredo.
NEXT_PUBLIC_POSTHOG_KEY=
